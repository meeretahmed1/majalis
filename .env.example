# رابط قاعدة بيانات PostgreSQL
# مثال محلي عبر Docker:      postgresql://postgres:postgres@localhost:5432/majalis
# مثال Neon/Supabase (سحابي): postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/majalis"

# مفتاح تشفير جلسات NextAuth — ولّده بالأمر: openssl rand -base64 32
NEXTAUTH_SECRET="ضع-هنا-مفتاحاً-عشوائياً-طويلاً"

# رابط الموقع (يُستخدم داخلياً بواسطة NextAuth)
NEXTAUTH_URL="http://localhost:3000"

# Gemini AI generation (server-only, never prefix NEXT_PUBLIC_)
GEMINI_API_KEY=""
# Choose a Gemini model available to your account, e.g. gemini-2.0-flash
GEMINI_MODEL="gemini-2.0-flash"
